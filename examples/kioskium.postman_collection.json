{
  "info": {
    "_postman_id": "934050c1-8254-5050-88b3-13d234e5ad61",
    "name": "Kioskium control API",
    "description": "Drive a running Kioskium browser over its HTTP/JSON control API.\n\n1. Start a browser with a control port, e.g. `kiosk --windowed --control-port 7001 kioskium:test`.\n2. Set the collection variable `baseUrl` (default `http://127.0.0.1:7001`). The API listens on 127.0.0.1 only; for a remote device, tunnel it: `ssh -L 7001:127.0.0.1:7001 user@device`.\n3. If the browser was started with `--control-token`, put the token in the `token` variable. It is sent as `X-Kioskium-Token`; without a configured token the header is ignored.\n\nEvery response is JSON with `ok: true|false`; failures add `error`. Full reference: https://github.com/jerhemy/kioskium/blob/main/docs/API.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-Kioskium-Token",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{token}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "id": "ecd625da-b780-55cf-9083-b696471a0870",
      "name": "Status",
      "description": "Read the state of the running browser.",
      "item": [
        {
          "id": "7e452869-9076-5dbd-91c2-6a7ea5f3d002",
          "name": "Get status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "status"
              ]
            },
            "description": "Instance identity, current and target URL, loading `state` (`idle`, `connecting`, `loading`, `target`), split pane, DevTools / FPS visibility and versions. Also stores `appId` in the collection variables."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('ok is true', () => pm.expect(pm.response.json().ok).to.eql(true));",
                  "const j = pm.response.json();",
                  "pm.test('has state', () => pm.expect(['idle', 'connecting', 'loading', 'target']).to.include(j.state));",
                  "pm.collectionVariables.set('appId', j.appId);"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/status",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "status"
                  ]
                },
                "description": "Instance identity, current and target URL, loading `state` (`idle`, `connecting`, `loading`, `target`), split pane, DevTools / FPS visibility and versions. Also stores `appId` in the collection variables."
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"ok\": true,\n  \"appId\": \"left-screen\",\n  \"name\": \"left-screen\",\n  \"pid\": 35692,\n  \"url\": \"http://localhost:8080/home\",\n  \"targetUrl\": \"http://localhost:8080/\",\n  \"state\": \"target\",\n  \"loadFailures\": 0,\n  \"split\": null,\n  \"devtools\": false,\n  \"fps\": false,\n  \"kiosk\": true,\n  \"version\": [\n    \"PySide6 6.12.0, Qt 6.12.0, QtWebEngine 6.140.0\",\n    \"Chromium 140.0.7339.225 (security patches up to 152.0.7977.83)\"\n  ]\n}"
            }
          ]
        }
      ]
    },
